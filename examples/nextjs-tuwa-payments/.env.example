# Secret key of your Quasar Payments app (sk_test_... or sk_live_..., server only): Apps → your app → Reveal secret
QUASAR_SECRET_KEY=

# Signing secret of the app's webhook endpoint (whsec_..., server only): your app → Webhooks
QUASAR_WEBHOOK_SECRET=

# Quasar API: the engine of your own node. Leave it empty for Quasar Cloud (https://api.tuwa.io)
NEXT_PUBLIC_QUASAR_BASE_URL=http://localhost:3001

# Origin of the app: the WalletConnect metadata and the links the checkout returns to.
# Default: http://localhost:3012. Set it for every deployment.
# NEXT_PUBLIC_APP_URL=https://your-shop.example.com

# WalletConnect project ID (https://dashboard.reown.com). Default: the project of the TUWA demos; use your own for your app
# NEXT_PUBLIC_WALLET_PROJECT_ID=

# Alchemy API key for the RPC URLs of the checkout (balances and fees on Base Sepolia, Sepolia and Solana devnet).
# Default: public, rate-limited RPC URLs
# NEXT_PUBLIC_ALCHEMY_KEY=
