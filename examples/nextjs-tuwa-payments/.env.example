# Quasar's `pnpm seed:dev` writes both secrets below when SEED_DEV_SHOP_ENV_FILE is the path of this shop's .env

# Secret key of your Quasar Payments app (sk_test_..., server only): Apps → your app → Reveal secret.
# The shop takes test payments: it refuses a live key (sk_live_...) unless SHOP_LIVE_PAYMENTS=true
QUASAR_SECRET_KEY=

# Signing secret of the app's webhook endpoint (whsec_..., server only): shown once when you create the app with a
# webhook URL, or your app → Webhooks
QUASAR_WEBHOOK_SECRET=

# Quasar API: the engine of your own node. Leave it empty for Quasar Cloud (https://api.tuwa.io)
NEXT_PUBLIC_QUASAR_BASE_URL=http://localhost:3001

# Origin of the app: the links the checkout returns to.
# Default: http://localhost:3012. Set it for every deployment.
# NEXT_PUBLIC_APP_URL=https://your-shop.example.com

# Alchemy API key for the RPC URLs of the checkout (balances and fees on Sepolia, Base Sepolia and Solana devnet).
# It is public (the browser sees it): restrict it to your domain. Default: public, rate-limited RPC URLs
# NEXT_PUBLIC_ALCHEMY_KEY=

# Live payments: lets the shop work with a live secret key. Add the networks of your methods to
# src/configs/appConfig.ts first.
# SHOP_LIVE_PAYMENTS=true

# Merchant mode: a paid order also shows the refund button (from your wallet). It acts with the secret key for
# whoever opens the page: only on your own machine, never on a public deployment.
# SHOP_MERCHANT_MODE=true
