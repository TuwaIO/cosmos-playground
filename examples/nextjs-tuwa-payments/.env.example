# Quasar's `pnpm seed:dev` writes both secrets below when SEED_DEV_SHOP_ENV_FILE is the path of this shop's .env

# Secret key of your Quasar Payments app (sk_test_... or sk_live_..., server only): Apps → your app → Reveal secret
QUASAR_SECRET_KEY=

# Signing secret of the app's webhook endpoint (whsec_..., server only): shown once when you create the app with a
# webhook URL, or your app → Webhooks
QUASAR_WEBHOOK_SECRET=

# Quasar API: the engine of your own node. Leave it empty for Quasar Cloud (https://api.tuwa.io)
NEXT_PUBLIC_QUASAR_BASE_URL=http://localhost:3001

# Origin of the app: the links the checkout returns to.
# Default: http://localhost:3012. Set it for every deployment.
# NEXT_PUBLIC_APP_URL=https://your-shop.example.com

# Alchemy API key for the RPC URLs of the checkout (balances and fees on Base Sepolia, Sepolia and Solana devnet).
# Default: public, rate-limited RPC URLs
# NEXT_PUBLIC_ALCHEMY_KEY=

# Demo mode: run the shop without Quasar and without keys, on a simulation of the Payments API with sample orders.
# Pay a Solana method by QR code and the demo "receives" the payment a few seconds later; nothing is sent on-chain.
# For trying and filming the shop; leave it off to sell.
# SHOP_DEMO_MODE=true

# Merchant mode: the order page also shows refunds (from your wallet) and the pause, resume and cancel of
# subscriptions. They act with the secret key for whoever opens the page: only on your own machine, never on a public
# deployment.
# SHOP_MERCHANT_MODE=true
