# WalletConnect Cloud Project ID (Required for EVM extension/mobile wallets)
NEXT_PUBLIC_WALLET_PROJECT_ID=your_walletconnect_project_id

# Optional: Alchemy API key for fallback RPC
NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_key

# Pimlico API key for ERC-4337 UserOperation bundler and gas sponsorship
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key
