# WalletConnect project ID (https://dashboard.reown.com). Default: the project of the TUWA demos; use your own for your app
# VITE_WALLET_PROJECT_ID=

# Alchemy API key for the Ethereum Mainnet, Sepolia and Solana Mainnet RPC URLs. Default: public, rate-limited RPC URLs
# VITE_ALCHEMY_KEY=

# Pimlico API key (https://dashboard.pimlico.io) for the ERC-4337 smart account transaction
# VITE_PIMLICO_API_KEY=
