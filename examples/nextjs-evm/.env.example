# Origin of the app: the WalletConnect metadata and the only domain the SIWX server accepts.
# Default: http://localhost:3000. Set it for every deployment.
# NEXT_PUBLIC_APP_URL=https://your-app.example.com

# WalletConnect project ID (https://dashboard.reown.com). Default: the project of the TUWA demos; use your own for your app
# NEXT_PUBLIC_WALLET_PROJECT_ID=

# Alchemy API key for the Ethereum Mainnet and Sepolia RPC URLs. Default: public, rate-limited RPC URLs
# NEXT_PUBLIC_ALCHEMY_KEY=

# Pimlico API key (https://dashboard.pimlico.io) for the ERC-4337 smart account transaction
# NEXT_PUBLIC_PIMLICO_API_KEY=

# Signs the SIWX session cookies (server only, at least 32 characters): openssl rand -base64 32
# Required in production; `next dev` uses a random secret per server start.
SIWX_DEMO_SIGNING_SECRET=
